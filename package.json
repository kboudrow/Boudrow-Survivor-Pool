{
  "name": "nfl-survivor-pool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --no-warnings --test tests/*.test.ts",
    "test:season-sim": "node --env-file=.env.local scripts/test-multi-pool-season-simulation.mjs",
    "test:week-rollover": "node --env-file=.env.local scripts/test-week-rollover-audit.mjs",
    "test:postseason": "node --no-warnings --test tests/postseasonIntegrity.test.ts tests/nflFeedResilience.test.ts",
    "test:concurrency": "node --env-file=.env.local scripts/test-concurrency-audit.mjs",
    "test:partial-failure": "node --env-file=.env.local scripts/test-partial-failure-recovery.mjs",
    "test:pick-secrecy": "node --env-file=.env.local scripts/test-pick-secrecy-audit.mjs",
    "quality:rpc": "node scripts/check-rpc-sql-coverage.mjs",
    "quality:migrations": "node scripts/check-migration-integrity.mjs",
    "production:audit": "node --env-file=.env.local scripts/audit-production-readiness.mjs",
    "load:test": "node scripts/load-test.mjs",
    "backup:db": "node scripts/db-backup.mjs",
    "backup:api": "node --env-file=.env.local scripts/api-backup.mjs",
    "schedule:sql": "node scripts/write-nfl-schedule-sql.mjs",
    "supabase": "node scripts/supabase-cli.mjs",
    "supabase:login": "node scripts/supabase-cli.mjs login",
    "supabase:types": "node scripts/generate-supabase-types.mjs",
    "supabase:link": "node scripts/supabase-cli.mjs link",
    "supabase:status": "node scripts/supabase-cli.mjs status",
    "staging:seed": "node --env-file=.env.local --env-file-if-exists=.env.staging.local scripts/seed-staging.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.70.0",
    "@supabase/supabase-js": "^2.55.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^15.5.23",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.19",
    "supabase": "^2.106.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "ws": "^8.21.0"
  }
}
